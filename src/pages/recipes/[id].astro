---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({
    params: { id: recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);
const base = import.meta.env.BASE_URL;

const servingsNum = recipe.data.servings ?? null;
const maxServings = servingsNum ? Math.max(servingsNum * 4, 12) : 12;

const hydrationNum = recipe.data.hydration ?? null;
const minHydration = hydrationNum ? Math.min(50, Math.floor(hydrationNum)) : 50;
const maxHydration = hydrationNum ? Math.max(90, Math.ceil(hydrationNum)) : 90;
---

<Layout title={`${recipe.data.title} — Cook`} description={recipe.data.description}>
  <a class="back-link" href={base}>&larr; All recipes</a>

  <article>
    {recipe.data.image && (
      <img class="recipe-hero" src={recipe.data.image} alt={recipe.data.title} />
    )}
    <header class="recipe-header">
      <h1>{recipe.data.title}</h1>
      {recipe.data.description && <p class="recipe-description">{recipe.data.description}</p>}
    </header>

    <div class="recipe-meta">
      {recipe.data.prepTime && <span><strong>Prep:</strong> {recipe.data.prepTime}</span>}
      {recipe.data.cookTime && <span><strong>Cook:</strong> {recipe.data.cookTime}</span>}
    </div>

    {servingsNum && (
      <div class="servings-control" data-base-servings={servingsNum}>
        <strong>Servings:</strong>
        <button type="button" class="servings-step" data-step="-1" aria-label="Decrease servings">&minus;</button>
        <input
          type="range"
          class="servings-slider"
          min="1"
          max={maxServings}
          step="1"
          value={servingsNum}
          aria-label="Servings"
        />
        <button type="button" class="servings-step" data-step="1" aria-label="Increase servings">&plus;</button>
        <output class="servings-output">{servingsNum}</output>
      </div>
    )}

    {hydrationNum && (
      <div class="hydration-control" data-base-hydration={hydrationNum}>
        <strong>Hydration:</strong>
        <button type="button" class="hydration-step" data-step="-1" aria-label="Decrease hydration">&minus;</button>
        <input
          type="range"
          class="hydration-slider"
          min={minHydration}
          max={maxHydration}
          step="1"
          value={hydrationNum}
          aria-label="Hydration percentage"
        />
        <button type="button" class="hydration-step" data-step="1" aria-label="Increase hydration">&plus;</button>
        <output class="hydration-output">{hydrationNum}%</output>
      </div>
    )}

    <div class="recipe-content">
      <Content />
    </div>
  </article>
</Layout>

{(servingsNum || hydrationNum) && (
  <script>
    function parseQuantity(str: string): number {
      const trimmed = str.trim();
      if (trimmed.includes(' ')) {
        const [whole, frac] = trimmed.split(' ');
        const [n, d] = frac.split('/').map(Number);
        return Number(whole) + n / d;
      }
      if (trimmed.includes('/')) {
        const [n, d] = trimmed.split('/').map(Number);
        return n / d;
      }
      return parseFloat(trimmed);
    }

    function formatQuantity(value: number): string {
      if (value <= 0.001) return '0';
      const wholePart = Math.floor(value + 1e-6);
      const remainder = value - wholePart;

      if (remainder < 0.04) {
        return wholePart > 0 ? String(wholePart) : String(Math.round(value * 10) / 10);
      }

      const fractions: [number, number][] = [
        [1, 8], [1, 4], [1, 3], [1, 2], [2, 3], [3, 4], [5, 8], [7, 8],
      ];
      let best: [number, number] | null = null;
      let bestDiff = Infinity;
      for (const [n, d] of fractions) {
        const diff = Math.abs(remainder - n / d);
        if (diff < bestDiff) {
          bestDiff = diff;
          best = [n, d];
        }
      }

      if (best && bestDiff < 0.045) {
        const fracStr = `${best[0]}/${best[1]}`;
        return wholePart > 0 ? `${wholePart} ${fracStr}` : fracStr;
      }

      const rounded = Math.round(value * 100) / 100;
      return String(rounded);
    }

    function init() {
      const heading = Array.from(document.querySelectorAll('.recipe-content h2')).find(
        (h) => h.textContent?.trim().toLowerCase() === 'ingredients'
      );
      const list = heading?.nextElementSibling;
      if (!list || !(list.tagName === 'UL' || list.tagName === 'OL')) return;

      const items = Array.from(list.querySelectorAll('li')).map((li) => {
        const original = li.textContent ?? '';
        const match = original.match(/^(\d+\s+\d+\/\d+|\d+\/\d+|\d+(?:\.\d+)?)(\s*)(.*)$/s);
        if (!match) return null;
        const baseQty = parseQuantity(match[1]);
        return { li, baseQty, whitespace: match[2], suffix: match[3] };
      });

      const flourItem = items.find((item) => item && /\bflour\b/i.test(item.suffix));
      const waterItem = items.find((item) => item && /\bwater\b/i.test(item.suffix));

      let servingsRatio = 1;

      function applyWater(hydrationPercent: number) {
        if (!waterItem || !flourItem) return;
        const waterQty = flourItem.baseQty * servingsRatio * (hydrationPercent / 100);
        waterItem.li.textContent = `${formatQuantity(waterQty)}${waterItem.whitespace}${waterItem.suffix}`;
      }

      const hydrationSlider = document.querySelector<HTMLInputElement>('.hydration-slider');
      const hydrationOutput = document.querySelector<HTMLOutputElement>('.hydration-output');
      const hydrationSteps = document.querySelectorAll<HTMLButtonElement>('.hydration-step');

      function updateHydration(hydrationPercent: number) {
        if (hydrationOutput) hydrationOutput.textContent = `${hydrationPercent}%`;
        applyWater(hydrationPercent);
      }

      function syncWater() {
        if (hydrationSlider) {
          applyWater(parseFloat(hydrationSlider.value));
        } else if (waterItem) {
          const scaled = waterItem.baseQty * servingsRatio;
          waterItem.li.textContent = `${formatQuantity(scaled)}${waterItem.whitespace}${waterItem.suffix}`;
        }
      }

      if (hydrationSlider && hydrationOutput && flourItem && waterItem) {
        hydrationSlider.addEventListener('input', () => updateHydration(parseFloat(hydrationSlider.value)));
        hydrationSteps.forEach((btn) => {
          btn.addEventListener('click', () => {
            const step = parseFloat(btn.dataset.step ?? '0');
            const next = Math.min(
              Number(hydrationSlider.max),
              Math.max(Number(hydrationSlider.min), parseFloat(hydrationSlider.value) + step)
            );
            hydrationSlider.value = String(next);
            updateHydration(next);
          });
        });
      }

      const servingsControl = document.querySelector<HTMLElement>('.servings-control');
      const servingsSlider = document.querySelector<HTMLInputElement>('.servings-slider');
      const servingsOutput = document.querySelector<HTMLOutputElement>('.servings-output');
      const servingsSteps = document.querySelectorAll<HTMLButtonElement>('.servings-step');
      const baseServings = parseFloat(servingsControl?.dataset.baseServings ?? '0');

      if (servingsControl && servingsSlider && servingsOutput && baseServings) {
        function update(servings: number) {
          servingsOutput.textContent = String(servings);
          servingsRatio = servings / baseServings;
          for (const item of items) {
            if (!item || item === waterItem) continue;
            const scaled = item.baseQty * servingsRatio;
            item.li.textContent = `${formatQuantity(scaled)}${item.whitespace}${item.suffix}`;
          }
          syncWater();
        }

        servingsSlider.addEventListener('input', () => update(parseFloat(servingsSlider.value)));
        servingsSteps.forEach((btn) => {
          btn.addEventListener('click', () => {
            const step = parseFloat(btn.dataset.step ?? '0');
            const next = Math.min(
              Number(servingsSlider.max),
              Math.max(Number(servingsSlider.min), parseFloat(servingsSlider.value) + step)
            );
            servingsSlider.value = String(next);
            update(next);
          });
        });
      }
    }

    init();
  </script>
)}
